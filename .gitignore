# 파이썬 가상환경과 산출물 (어느 위치든)
.venv/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
backend/tests/_out/

# 프런트 의존성과 빌드 산출물
node_modules/
frontend/dist/

# 도구 작업공간과 임시 리뷰 기록 (공개 저장소에 올리지 않는다)
.superpowers/
.worktrees/

# 운영체제와 편집기 임시 파일 (2026-09-02 단계 5A D1: macOS 전환)
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo

# 런타임 프로젝트 데이터 (앱이 만드는 폴더. 저장소 안에 두더라도 올리지 않는다).
# 저장소 루트 바로 아래만 무시한다: 하위 경로의 같은 이름(frontend/src/pages/projects/ 등)은 정상 소스다 (감사기와 같은 기준)
/projects/
/uploads/
/exports/
/snapshots/

# 인증정보 (예시 파일만 허용)
.env
.env.*
!.env.example

# 회사 자료(오피스 파일)가 저장소 폴더에 놓여도 개인 GitHub로 올라가지 않도록 막는다 (2026-09-01. 파일럿 중 docs/pilot과 루트에 xlsx, pptx가 놓인 것을 발견)
# 2026-09-02 단계 5A D1: 위치와 관계없이 전부 무시하고, 단계 5A B가 만들 비기밀 합성 XLSX 픽스처만 예외로 허용한다
*.pptx
*.ppt
*.xlsx
*.xls
*.docx
*.doc
*.pdf
!backend/tests/fixtures/synthetic/*.xlsx

# 파일럿 폴더는 날짜가 붙은 관찰지(앱 사용 경험만 적는 문서)만 추적한다. 원자료와 추출물은 확장자와 관계없이 무시한다
docs/pilot/*
!docs/pilot/????-??-??-파일럿-관찰지.md
